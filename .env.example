# ============== Runtime ==============
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MIN=120

# ============== Postgres ==============
POSTGRES_USER=mizan_admin
POSTGRES_PASSWORD=change_me_postgres_password_min_16_chars
POSTGRES_DB=mizan_erp_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://mizan_admin:change_me_postgres_password_min_16_chars@localhost:5432/mizan_erp_db?schema=public&connection_limit=10"

# ============== Redis ==============
REDIS_PASSWORD=change_me_redis_password_min_16_chars
REDIS_PORT=6379
REDIS_URL="redis://:change_me_redis_password_min_16_chars@localhost:6379"

# ============== JWT ==============
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_WITH_96_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_DIFFERENT_96_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ============== AI ==============
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ============== Tests ==============
TEST_DATABASE_URL="postgresql://mizan_admin:change_me_postgres_password_min_16_chars@localhost:5432/mizan_test_db?schema=public"
