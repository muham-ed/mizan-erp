# ============== Runtime ==============
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MIN=120

# ============== Postgres — Root (bootstrap only) ==============
POSTGRES_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_MIN_32_CHARS
POSTGRES_DB=mizan_erp_db
POSTGRES_PORT=5432

# ============== Postgres — Application roles ==============
POSTGRES_MIGRATOR_USER=mizan_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD_MIN_32_CHARS
POSTGRES_APP_USER=mizan_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD_MIN_32_CHARS

# Admin URL — only for DB creation in dev/test
POSTGRES_ADMIN_URL="postgresql://postgres:CHANGE_ME_ROOT_PASSWORD_MIN_32_CHARS@localhost:5432/postgres"

# App runtime — RLS applies to this user
DATABASE_URL="postgresql://mizan_app:CHANGE_ME_APP_PASSWORD_MIN_32_CHARS@localhost:5432/mizan_erp_db?schema=public&connection_limit=10"

# Migrations — owns schema, NO BYPASSRLS
MIGRATE_DATABASE_URL="postgresql://mizan_migrator:CHANGE_ME_MIGRATOR_PASSWORD_MIN_32_CHARS@localhost:5432/mizan_erp_db?schema=public"

# Tests
TEST_DATABASE_URL="postgresql://mizan_migrator:CHANGE_ME_MIGRATOR_PASSWORD_MIN_32_CHARS@localhost:5432/mizan_test_db?schema=public"

# ============== Redis ==============
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS
REDIS_PORT=6379
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS@localhost:6379"

# ============== JWT ==============
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_96_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_96_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ============== AI ==============
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini